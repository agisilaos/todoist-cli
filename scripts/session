#!/usr/bin/env python3
"""Worktree kickoff, overlap checks, and the maintainer's direct landing gate."""

import argparse
from contextlib import contextmanager
import fcntl
import json
import os
from pathlib import Path
import re
import shlex
import shutil
import subprocess
import sys
import tempfile
import unicodedata
from urllib.parse import unquote, urlsplit


MAIN = "refs/heads/main"
BASE = "refs/remotes/origin/main"
REVIEW_SCHEMA = {
    "type": "object",
    "additionalProperties": False,
    "required": ["verdict", "findings"],
    "properties": {
        "verdict": {"type": "string", "enum": ["clean", "findings", "blocked"]},
        "findings": {"type": "array", "items": {"type": "string"}},
    },
}


class Refusal(Exception):
    pass


def git(*args, cwd=None, capture=True, env=None, allowed=(0,)):
    result = subprocess.run(
        ["git", "--no-optional-locks", "-c", "advice.graftFileDeprecated=false",
         "-c", "core.fsmonitor=false", *args],
        cwd=cwd, env=env,
        stdout=subprocess.PIPE if capture else None,
    )
    if result.returncode not in allowed:
        result.check_returncode()
    return os.fsdecode(result.stdout) if capture else ""


def git_dir(cwd=None):
    return Path(git("rev-parse", "--absolute-git-dir", cwd=cwd).rstrip("\n"))


def worktrees(root):
    for field in git("worktree", "list", "--porcelain", "-z", cwd=root).split("\0"):
        if field.startswith("worktree "):
            yield Path(field[len("worktree "):]).resolve()


FETCH_MAIN = (
    "-c", "fetch.bundleURI=", "fetch", "--no-tags", "--no-prune", "--no-prune-tags",
    "--no-auto-maintenance", "--no-write-commit-graph", "--no-write-fetch-head",
    "--quiet", "--refmap=",
)


def fetch_main():
    git(*FETCH_MAIN, "origin", f"+{MAIN}:{BASE}")
    return git("rev-parse", BASE).strip()


def branch_name(name):
    if not re.fullmatch(r"[a-z0-9]+(?:-[a-z0-9]+)*", name):
        raise Refusal("choose a lowercase session name with letters, digits and hyphens")
    return f"fix/{name}"


def owned_branch(root, primary):
    branch = git("rev-parse", "--abbrev-ref", "HEAD", cwd=root).strip()
    name = branch[len("fix/"):]
    if not branch.startswith("fix/") or root != primary.with_name(f"{primary.name}-{name}"):
        raise Refusal("run this in the sibling worktree created by scripts/session start")
    return branch


def within(path, parent):
    return path == parent or parent in path.parents


def hidden_paths(cwd=None):
    entries = git("ls-files", "-v", "-z", cwd=cwd).split("\0")
    return {entry[2:] for entry in entries if entry and
            (entry[0] == "S" or entry[0].islower())}


def require_no_operation(metadata):
    in_progress = ("rebase-merge", "rebase-apply", "MERGE_HEAD", "BISECT_START",
                   "CHERRY_PICK_HEAD", "REVERT_HEAD", "sequencer")
    if any((metadata / name).exists() for name in in_progress):
        raise Refusal("finish or abort the in-progress Git operation first")


def require_clean():
    require_no_operation(git_dir())
    if hidden_paths():
        raise Refusal("clear assume-unchanged and skip-worktree flags before continuing")
    if git("status", "--porcelain", "-z", "--untracked-files=all"):
        raise Refusal("the session has uncommitted changes")
    if git("ls-files", "--others", "--ignored", "--exclude-standard", "-z"):
        raise Refusal("the session has ignored files; move or remove them before continuing")


def require_supported_hooks():
    config = git("config", "--null", "--get-regexp", r"^hook\..+\.event$", allowed=(0, 1))
    names = ("pre-push", "pre-rebase", "prepare-commit-msg", "pre-commit", "commit-msg",
             "post-checkout", "post-rewrite", "post-commit", "post-merge",
             "post-index-change", "reference-transaction")
    for setting in config.split("\0"):
        key, _, event = setting.partition("\n")
        if event in names:
            enabled = git("config", "--type=bool", "--get", f"{key[:-len('event')]}enabled",
                          allowed=(0, 1)).strip()
            if enabled != "false":
                raise Refusal(f"the source checkout has a configured {event} hook")
    directory = git("config", "--null", "--path", "--get", "core.hooksPath",
                    allowed=(0, 1)).partition("\0")[0]
    if directory and not Path(directory).is_dir():
        return
    for name in names:
        hook = git("rev-parse", "--path-format=absolute", "--git-path", f"hooks/{name}").rstrip("\n")
        if os.path.isfile(hook) and os.access(hook, os.X_OK):
            raise Refusal(f"the source checkout has a {name} hook. This landing workflow "
                          f"requires a checkout without a {name} hook")


def require_supported_rebase():
    attributes = Path(git("rev-parse", "--path-format=absolute",
                          "--git-path", "info/attributes").rstrip("\n"))
    drivers = git("config", "--name-only", "--get-regexp", r"^merge\.(default|.+\.driver)$",
                  allowed=(0, 1))
    if drivers or (attributes.is_file() and attributes.stat().st_size):
        raise Refusal("automatic landing requires built-in merge drivers and no local "
                      "info/attributes overrides")


@contextmanager
def landing_turn():
    common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").rstrip("\n"))
    with (common / "todoist-landing.lock").open("a") as lock:
        try:
            fcntl.flock(lock, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            print("Waiting for another session to finish landing.", flush=True)
            fcntl.flock(lock, fcntl.LOCK_EX)
        yield


def evidence_dir(root):
    if sys.platform == "darwin":
        state = Path.home() / "Library/Logs"
    else:
        state = Path(os.environ.get("XDG_STATE_HOME") or Path.home() / ".local/state")
    parent = Path(os.environ.get("TODOIST_SESSION_LOG_DIR") or state / "todoist-cli/sessions").resolve()
    if any(within(parent, tree) for tree in worktrees(root)):
        raise Refusal("the session log directory must be outside the repository")
    parent.mkdir(parents=True, exist_ok=True)
    path = Path(tempfile.mkdtemp(prefix="land-", dir=parent))
    print(f"Landing evidence: {path}", flush=True)
    return path


def logged_run(argv, path, *, cwd, env):
    print(f"Running {Path(argv[0]).name}; full log: {path}", flush=True)
    with path.open("w") as log:
        result = subprocess.run(argv, stdin=subprocess.DEVNULL, stdout=log,
                                stderr=subprocess.STDOUT, cwd=cwd, env=env)
    if result.returncode:
        raise Refusal(f"{Path(argv[0]).name} exited {result.returncode}; see {path}")


def review(base, head, evidence, checkout, env):
    schema = evidence / "review-schema.json"
    schema.write_text(json.dumps(REVIEW_SCHEMA))
    output = evidence / "review.json"
    prompt = (
        f"Independently review the committed changes from {base} to {head} for actionable "
        "regressions and repository contract violations. Inspect the complete diff with "
        f"git --no-pager diff --no-ext-diff --no-textconv {base} {head} and read relevant "
        "surrounding code and repo guidance. Report concrete, actionable failures in "
        "the documented workflow, including any risk of lost work or skipped checks. "
        "Do not change files, push, or run the landing workflow. Return verdict clean "
        "and an empty findings list only if you completed the review and found no "
        "actionable issues. Use findings for defects with file and line, or blocked "
        "if you could not finish; explain the blocker in findings."
    )
    logged_run([
        trusted_executable(os.environ.get("TODOIST_CODEX", "codex"), env),
        "exec", "--sandbox", "read-only",
        "--ephemeral", "--output-schema", str(schema), "--output-last-message", str(output),
        prompt,
    ], evidence / "review.log", cwd=checkout, env=env)
    try:
        verdict = json.loads(output.read_text())
    except (OSError, ValueError):
        raise Refusal(f"review did not return a verdict; see {evidence / 'review.log'}") from None
    if verdict != {"verdict": "clean", "findings": []}:
        raise Refusal(f"review did not clear the change; see {output}")


def push_destination():
    urls = git("remote", "get-url", "--push", "--all", "origin").splitlines()
    if len(urls) != 1 or urls != git("remote", "get-url", "--all", "origin").splitlines():
        raise Refusal("origin must use the same single URL for fetching and pushing")
    url = urls[0]
    raw = git("config", "--null", "--get-regexp",
              r"^remote\.origin\.(url|pushurl|vcs|uploadpack|receivepack)$")
    if raw != f"remote.origin.url\n{url}\0":
        raise Refusal("configure one direct origin URL without pushurl, URL rewrites or "
                      "custom remote helpers")
    scheme, separator, _ = url.partition("://")
    if (separator and scheme not in {"http", "https", "ssh", "git", "file"}) or re.match(
        r"^[a-zA-Z][a-zA-Z0-9+.-]*::", url
    ):
        raise Refusal("origin must use a standard Git transport, without remote helper URLs")
    if scheme == "file" and separator:
        local = urlsplit(url)
        if local.netloc not in ("", "localhost") or local.query or local.fragment:
            raise Refusal("use a local file URL without a query or fragment")
        url = unquote(local.path)
    if ":" not in url.split("/", 1)[0] and not os.path.isabs(url):
        raise Refusal("origin must use a URL or an absolute local path")
    if os.path.isabs(url):
        url = str(Path(url).resolve(strict=True))
        if git("ls-remote", "--get-url", "--", url).rstrip("\n") != url:
            raise Refusal("the resolved local origin path is subject to a Git URL rewrite")
    return url


def local_transport_option(destination, service):
    if not os.path.isabs(destination):
        return []
    # A local receiver is a separate Git server. Restore the original
    # configuration environment rather than inheriting the isolated client's.
    keys = ("GIT_CONFIG_GLOBAL", "GIT_CONFIG_SYSTEM", "GIT_CONFIG_NOSYSTEM")
    command = ["env"]
    for key in (*keys, "GIT_CONFIG_PARAMETERS", "GIT_CONFIG_COUNT"):
        command.extend(("-u", key))
    command.extend(f"{key}={os.environ[key]}" for key in keys if key in os.environ)
    return [f"--{service}={shlex.join([*command, 'git', service])}"]


def require_remote_base(destination, base, metadata, env):
    if destination != push_destination():
        raise Refusal("origin's URL changed; inspect it before retrying")
    tip = git(f"--git-dir={metadata}", "ls-remote", "--exit-code",
              *local_transport_option(destination, "upload-pack"), "origin", MAIN,
              env=env).strip()
    if tip != f"{base}\t{MAIN}":
        raise Refusal("origin/main moved; land again against the new base")


def require_candidate(root, primary, branch, head):
    require_clean()
    if owned_branch(root, primary) != branch or git("rev-parse", "HEAD").strip() != head:
        raise Refusal("the session changed during qualification; land again")


def write_base_record(path, base):
    temporary = path.with_suffix(".tmp")
    temporary.write_text(f"{base}\n")
    temporary.replace(path)


def record_rebase_target(base):
    metadata = git_dir()
    receipt = metadata / "todoist-session-base"
    pending = metadata / "todoist-session-target"
    try:
        previous = receipt.read_text().strip()
        if pending.exists():
            attempted = pending.read_text().strip()
            if git("merge-base", attempted, "HEAD", allowed=(0, 1)).strip() == attempted:
                previous = attempted
                write_base_record(receipt, previous)
        git("--no-replace-objects", "merge-base", "--is-ancestor", previous, base)
    except (OSError, subprocess.CalledProcessError):
        raise Refusal("origin/main no longer contains the recorded session base, or the base "
                      "is missing. Inspect the history before starting a fresh session.") from None
    fork = git("merge-base", "--fork-point", BASE, "HEAD", allowed=(0, 1)).strip()
    if not fork:
        # A tracking reflog can be disabled or expire. The recorded base is
        # durable for branches rebased through this workflow.
        try:
            git("merge-base", "--is-ancestor", previous, "HEAD")
        except subprocess.CalledProcessError:
            raise Refusal("cannot establish the session's upstream boundary") from None
        fork = previous
    try:
        git("merge-base", "--is-ancestor", fork, base)
    except subprocess.CalledProcessError:
        raise Refusal("origin/main no longer contains the session's fork point. "
                      "Inspect the history before starting a fresh session.") from None
    # A completed manual resolution contains the attempted target in its history.
    # An aborted rebase keeps the last successful base.
    write_base_record(pending, base)


def finish_rebase(base):
    metadata = git_dir()
    write_base_record(metadata / "todoist-session-base", base)
    (metadata / "todoist-session-target").unlink()


def reconcile_publication(base):
    metadata = git_dir()
    pending = metadata / "todoist-session-publication"
    if not pending.exists():
        return
    published = pending.read_text().strip()
    try:
        git("merge-base", "--is-ancestor", published, base)
    except subprocess.CalledProcessError:
        raise Refusal(f"the outcome of the previous push of {published} is uncertain. "
                      f"Verify it never landed before clearing {pending} and retrying.") from None
    write_base_record(metadata / "todoist-session-base", published)
    pending.unlink()


def candidate_environment():
    local_git_vars = set(git("rev-parse", "--local-env-vars").splitlines())
    env = {key: value for key, value in os.environ.items()
           if key not in local_git_vars and not key.startswith("GIT_CONFIG")}
    for name in ("MAKE", "MAKE_COMMAND", "MAKEFLAGS", "GNUMAKEFLAGS", "MFLAGS",
                 "MAKEOVERRIDES", "MAKEFILES", "BINARY", "GOFLAGS", "PYTHONOPTIMIZE"):
        env.pop(name, None)
    env.update(GOENV="off", GOWORK="off", GIT_CONFIG_NOSYSTEM="1",
               GIT_CONFIG_GLOBAL=os.devnull, GIT_NO_REPLACE_OBJECTS="1", GIT_ATTR_NOSYSTEM="1")
    roots = list(worktrees(Path.cwd()))
    env["PATH"] = os.pathsep.join(
        entry for entry in os.get_exec_path(env) if os.path.isabs(entry)
        and not any(within(Path(entry).resolve(), root) for root in roots)
    )
    return env


def trusted_executable(name, env):
    executable = shutil.which(name, path=env["PATH"])
    if not executable:
        raise Refusal(f"required executable not found on the qualification PATH: {name}")
    path = Path(executable).resolve()
    if any(within(path, tree) for tree in worktrees(Path.cwd())):
        raise Refusal(f"qualification executable is inside a repository worktree: {path}")
    return str(path)


def transport_config(destination):
    # Preserve the difference between a bare setting and an explicit empty value.
    transport = []
    for setting in git("config", "--null", "--list", "--includes").split("\0"):
        key, separator, value = setting.partition("\n")
        if key.startswith(("credential.", "http.", "https.", "ssh.", "protocol.", "gpg.",
                           "fetch.fsck.")) or key in (
            "core.sshcommand", "core.askpass", "core.gitproxy",
            "remote.origin.proxy", "remote.origin.proxyauthmethod",
            "push.gpgsign", "push.pushoption", "user.name", "user.email", "user.signingkey",
            "user.useconfigonly",
            "committer.name", "committer.email",
            "fetch.fsckobjects", "transfer.fsckobjects",
        ):
            transport.append((key, value if separator else None))
    return [*transport, ("remote.origin.url", destination)]


def write_transport_config(metadata, settings):
    def quote(value):
        return '"' + (value.replace("\\", "\\\\").replace('"', '\\"')
                      .replace("\n", "\\n").replace("\t", "\\t").replace("\b", "\\b")) + '"'

    # The checkout is private and removed after the attempt. Keep credential
    # settings out of command arguments and out of the review/check processes.
    with (metadata / "config").open("a", errors="surrogateescape") as config:
        for key, value in settings:
            prefix, option = key.rsplit(".", 1)
            section, dot, subsection = prefix.partition(".")
            header = f"{section} {quote(subsection)}" if dot else section
            assignment = "" if value is None else f" = {quote(value)}"
            config.write(f"\n[{header}]\n\t{option}{assignment}\n")


def require_portable_tree(head, cwd, env):
    names = git("ls-tree", "-r", "-t", "--name-only", "-z", head, cwd=cwd, env=env).split("\0")
    seen = {}
    for name in names:
        key = unicodedata.normalize("NFC", name).casefold()
        previous = seen.setdefault(key, name)
        if previous != name:
            raise Refusal(f"paths collide on macOS: {previous!r} and {name!r}")


@contextmanager
def candidate_checkout(head, evidence, *, bare=False):
    env = candidate_environment()
    object_format = git("rev-parse", "--show-object-format").strip()
    objects = git("rev-parse", "--path-format=absolute", "--git-path", "objects").rstrip("\n")
    with tempfile.TemporaryDirectory(prefix="push-" if bare else "candidate-", dir=evidence) as directory:
        checkout = Path(directory)
        options = ["--bare"] if bare else []
        git("init", "--quiet", "--template=", f"--object-format={object_format}", *options,
            cwd=checkout, env=env)
        metadata = checkout if bare else checkout / ".git"
        info = metadata / "objects/info"
        info.mkdir(exist_ok=True)
        (info / "alternates").write_text(f"{objects}\n")
        if not bare:
            git("config", "core.attributesFile", os.devnull, cwd=checkout, env=env)
            require_portable_tree(head, checkout, env)
            git("switch", "--quiet", "--detach", head, cwd=checkout, env=env)
        yield checkout, env


def fetch_pinned_main(destination, metadata, env):
    previous = git("rev-parse", "--verify", "--quiet", BASE, allowed=(0, 1)).strip()
    objects = git("rev-parse", "--path-format=absolute", "--git-path", "objects").rstrip("\n")
    # Store fetched objects in the source clone so its worktree can rebase onto
    # the exact commit read through the frozen transport.
    git(f"--git-dir={metadata}", *FETCH_MAIN, *local_transport_option(destination, "upload-pack"),
        "origin", f"+{MAIN}:{BASE}", env={**env, "GIT_OBJECT_DIRECTORY": objects})
    base = git(f"--git-dir={metadata}", "rev-parse", BASE, env=env).strip()
    git("update-ref", "-m", "session: refresh origin/main", BASE, base, previous)
    return base


def land(root, primary):
    with landing_turn():
        branch = owned_branch(root, primary)
        require_clean()
        require_supported_hooks()
        require_supported_rebase()
        original_head = git("rev-parse", "HEAD").strip()
        destination = push_destination()
        transport = transport_config(destination)
        # Keep the transport directory independent from both the reviewer and
        # the checks and use the same configuration for all remote operations.
        with candidate_checkout(original_head, None, bare=True) as (metadata, push_env):
            write_transport_config(metadata, transport)
            base = fetch_pinned_main(destination, metadata, push_env)
            require_candidate(root, primary, branch, original_head)
            reconcile_publication(base)
            if git("rev-list", "--merges", f"{base}..{original_head}"):
                raise Refusal("session history contains merge commits; prepare a linear branch")
            require_supported_rebase()
            require_supported_hooks()
            record_rebase_target(base)
            require_candidate(root, primary, branch, original_head)
            try:
                git("-c", f"core.attributesFile={os.devnull}", "-c", "rerere.enabled=false",
                    "-c", "rebase.instructionFormat=%s",
                    "rebase", "--merge", "--no-verify", "--no-autostash", "--no-autosquash",
                    "--no-update-refs", "--no-rebase-merges",
                    "--reapply-cherry-picks", "--empty=ask", base, capture=False)
            except subprocess.CalledProcessError:
                raise Refusal("rebase failed; inspect git status before retrying") from None
            finish_rebase(base)
            head = git("rev-parse", "HEAD").strip()
            if head == base:
                print(f"No commits to land; already at origin/main ({base}).")
                return
            require_clean()
            messages = git("log", "--no-show-signature", "--format=%B", "-z", f"{base}..{head}")
            if re.search(r"\[(skip ci|ci skip|no ci|skip actions|actions skip)\]", messages, re.I) or re.search(
                r"^skip-checks:[ \t]*true[ \t]*$", messages.replace("\0", "\n"), re.I | re.M
            ):
                raise Refusal("session commits must allow the ordinary GitHub push CI to run")
            makefile = git("ls-tree", head, "--", "Makefile").split()
            if not makefile or makefile[0] not in {"100644", "100755"}:
                raise Refusal("the candidate must have a regular tracked Makefile")
            evidence = evidence_dir(root)
            print(f"Reviewing {base}..{head}", flush=True)
            with candidate_checkout(head, evidence) as (checkout, env):
                for tool in ("git", "python3", "go", "gofmt", "bash", "make"):
                    trusted_executable(tool, env)
                review(base, head, evidence, checkout, env)
            require_candidate(root, primary, branch, head)
            require_remote_base(destination, base, metadata, push_env)
            with candidate_checkout(head, evidence) as (checkout, env):
                logged_run([trusted_executable("make", env), "-f", "Makefile", "check"],
                           evidence / "check.log",
                           cwd=checkout, env=env)
            require_candidate(root, primary, branch, head)
            require_supported_hooks()
            require_remote_base(destination, base, metadata, push_env)
            # Pair the lease with an ancestry check to allow only fast-forwards.
            git("merge-base", "--is-ancestor", base, head, cwd=metadata, env=push_env)
            receipt = git_dir()
            pending = receipt / "todoist-session-publication"
            write_base_record(pending, head)
            try:
                # Use the isolated Git directory but preserve the caller's working
                # directory for relative paths in SSH and other transport settings.
                output = git(f"--git-dir={metadata}",
                    "push", "--porcelain", "--no-follow-tags", "--recurse-submodules=no",
                    *local_transport_option(destination, "receive-pack"),
                    f"--force-with-lease={MAIN}:{base}", "origin", f"{head}:{MAIN}",
                    cwd=root, env={**push_env, "LC_ALL": "C"})
            except subprocess.CalledProcessError as error:
                output = os.fsdecode(error.stdout or b"")
                print(output, end="", flush=True)
                # Git's porcelain result distinguishes a refused ref from an
                # update whose outcome was lost with the transport connection.
                rejection = f"!\t{head}:{MAIN}\t"
                if any(line.startswith((rejection + "[rejected] ",
                                        rejection + "[remote rejected] "))
                       for line in output.splitlines()):
                    pending.unlink()
                raise Refusal(f"push exited {error.returncode}. Inspect Git's output before retrying.") from None
            print(output, end="", flush=True)
            # A future rewind must not make these already-landed commits eligible
            # for publication again, even before another fetch updates origin/main.
            write_base_record(receipt / "todoist-session-base", head)
            pending.unlink()
        print(f"Landed {head} on origin/main. Ordinary push CI runs separately.")


def worktree_history(tree, base, revision="HEAD"):
    head = git("rev-parse", "--verify", "--quiet", revision, cwd=tree, allowed=(0, 1)).strip()
    common = git("merge-base", base, head, cwd=tree, allowed=(0, 1)).strip() if head else ""
    return head, common


def touched_paths(common, head, cwd=None):
    return set(git("log", "--root", "--format=", "--name-only", "--no-renames", "-z",
                   "--no-show-signature", "--full-history", "--diff-merges=first-parent",
                   f"{common}..{head}" if common else head,
                   cwd=cwd).split("\0")) - {""}


def rebase_original(tree):
    metadata = git_dir(tree)
    for backend in ("rebase-merge", "rebase-apply"):
        try:
            original = (metadata / backend / "orig-head").read_text().strip()
        except FileNotFoundError:
            continue
        if re.fullmatch(r"[0-9a-f]{40}|[0-9a-f]{64}", original):
            return original
    return None


def other_worktree_commits(tree, base):
    original = rebase_original(tree)
    revisions = {"HEAD", original} if original else {"HEAD"}
    paths = set()
    for revision in revisions:
        head, common = worktree_history(tree, base, revision)
        if head:
            paths.update(touched_paths(common, head, cwd=tree))
    return paths


def overlaps(root, paths):
    ignore_case = git("config", "--type=bool", "--get", "core.ignorecase",
                      allowed=(0, 1)).strip() == "true"
    wanted = []
    for path in paths:
        relative = Path(os.path.abspath(path))
        if Path(path).is_absolute() or not within(relative, root):
            raise Refusal("give paths relative to the repository root")
        wanted.append(relative.relative_to(root))
    def normalize(path):
        name = unicodedata.normalize("NFC", str(path))
        return Path(name.casefold() if ignore_case else name)

    match_paths = [normalize(path) for path in wanted]

    def matches_path(file):
        file_path = normalize(file)
        return any(within(file_path, path) or within(path, file_path) for path in match_paths)

    base = fetch_main()
    matches = False
    for tree in worktrees(root):
        if tree == root or not tree.is_dir():
            continue
        hidden = hidden_paths(tree)
        changed = hidden | other_worktree_commits(tree, base)
        for args in (
            ("diff", "--cached", "--name-only", "--no-renames", "-z"),
            ("diff", "--name-only", "--no-renames", "-z"),
            ("ls-files", "--others", "--exclude-standard", "-z"),
        ):
            changed.update(git(*args, cwd=tree).split("\0"))
        for file in sorted(changed - {""}):
            if matches_path(file):
                detail = " (index flags may hide edits)" if file in hidden else ""
                print(f"{tree}: {file}{detail}")
                matches = True
    # Log paths as well as the commits: a landed change may have closed an overlap.
    _, common = worktree_history(root, base, rebase_original(root) or "HEAD")
    landed = []
    if common:
        landed = sorted(file for file in touched_paths(common, base) if matches_path(file))
    else:
        print("Upstream path comparison requires a shared commit with origin/main.")
    if landed:
        print("Changes on origin/main since this worktree diverged:")
        for file in landed:
            print(f"  {file}")
    if not matches and not landed:
        print("No overlap found.")


def end(root, primary):
    with landing_turn():
        branch = owned_branch(root, primary)
        require_clean()
        head = git("rev-parse", "HEAD").strip()
        base = fetch_main()
        require_candidate(root, primary, branch, head)
        if git("rev-list", f"{base}..{head}"):
            raise Refusal("the session has commits that are not on origin/main")
        require_candidate(root, primary, branch, head)
        metadata = git_dir()
        device = root.parent.stat().st_dev
        if root.stat().st_dev != device or metadata.stat().st_dev != device:
            raise Refusal("the checkout and its Git metadata must share a volume to archive the session")
        archive = Path(tempfile.mkdtemp(prefix=f".{primary.name}-ended-", dir=root.parent))
        saved = archive / "worktree"
        print(f"Retaining checkout files in {archive}", flush=True)
        ref = f"refs/heads/{branch}"
        bundle = archive / "session.bundle"
        git("bundle", "create", str(bundle), ref)
        if git("bundle", "list-heads", str(bundle), ref) != f"{head} {ref}\n":
            raise Refusal("the archived branch changed before cleanup")
        require_candidate(root, primary, branch, head)
        common = Path(git("rev-parse", "--path-format=absolute", "--git-common-dir").rstrip("\n"))
        git("worktree", "move", str(root), str(saved), cwd=primary, capture=False)
        archived_git = archive / "git-metadata"
        index_lock = metadata / "index.lock"
        try:
            lock = index_lock.open("xb")
        except FileExistsError:
            raise Refusal(f"Git is updating the index of the worktree now at {saved}") from None
        try:
            # Save staged blobs while Git still sees the linked index as a GC root.
            require_no_operation(metadata)
            if git("ls-files", "--unmerged", "-z", cwd=saved):
                raise Refusal(f"the moved worktree at {saved} contains unmerged index entries")
            patch = git("-c", "diff.suppressBlankEmpty=false", "diff", "--cached", "--binary",
                        "--no-color", "--no-ext-diff", "--no-textconv", "--unified=3",
                        "--no-relative", "--no-renames", "--word-diff=none",
                        "--src-prefix=a/", "--dst-prefix=b/", head, cwd=saved)
            (archive / "staged.patch").write_text(patch, errors="surrogateescape")
            # Unregister the worktree without deleting the index or the checkout.
            metadata.rename(archived_git)
            index_lock = archived_git / "index.lock"
        finally:
            lock.close()
            index_lock.unlink(missing_ok=True)
        (saved / ".git").unlink(missing_ok=True)
        (archive / "original-common-dir").write_text(f"{common}\n")
        if f"branch {ref}" in git("worktree", "list", "--porcelain", "-z", cwd=primary).split("\0"):
            raise Refusal("the worktree was removed but the branch is checked out elsewhere")
        # Use the exact branch tip verified against fetched main, independently of
        # local main and any upstream configuration on the session branch.
        git("update-ref", "-d", ref, head, cwd=primary, capture=False)
        if any(key.startswith(f"branch.{branch}.") for key in
               git("config", "--local", "--name-only", "--list", cwd=primary).splitlines()):
            git("config", "--local", "--remove-section", f"branch.{branch}", cwd=primary)
        print(f"Closed {root}. Retained checkout files at {saved}.")


def main():
    overrides = ("GIT_CONFIG", "GIT_DIR", "GIT_WORK_TREE", "GIT_IMPLICIT_WORK_TREE", "GIT_COMMON_DIR",
                 "GIT_INDEX_FILE", "GIT_OBJECT_DIRECTORY", "GIT_ALTERNATE_OBJECT_DIRECTORIES",
                 "GIT_SHALLOW_FILE", "GIT_PREFIX")
    active = [name for name in overrides if os.environ.get(name)]
    if active:
        raise Refusal(f"unset Git checkout overrides before running this command: {', '.join(active)}")
    os.environ["GIT_NO_REPLACE_OBJECTS"] = "1"
    os.environ["GIT_GRAFT_FILE"] = os.devnull
    os.environ["GIT_ATTR_NOSYSTEM"] = "1"
    for name in ("GIT_ATTR_SOURCE", "GIT_EXTERNAL_DIFF", "GIT_DIFF_OPTS",
                 "GIT_LITERAL_PATHSPECS", "GIT_GLOB_PATHSPECS", "GIT_NOGLOB_PATHSPECS",
                 "GIT_ICASE_PATHSPECS",
                 "BASH_ENV", "ENV", "SHELLOPTS", "BASHOPTS"):
        os.environ.pop(name, None)
    for name, value in list(os.environ.items()):
        if name.startswith("BASH_FUNC_") or value.startswith("() {"):
            del os.environ[name]
    parser = argparse.ArgumentParser(description=__doc__)
    commands = parser.add_subparsers(dest="command", required=True)
    commands.add_parser("start", help="create a worktree from fresh origin/main").add_argument("name")
    commands.add_parser("overlaps", help="check other sessions and main for changed paths").add_argument(
        "paths", nargs="+")
    commands.add_parser("land", help="review, check, and push to main (requires authorization)")
    commands.add_parser("end", help="remove this clean, fully landed session")
    args = parser.parse_args()
    version = re.search(r"\b(\d+)\.(\d+)", git("--version"))
    if not version or tuple(map(int, version.groups())) < (2, 38):
        raise Refusal("Git 2.38 or newer is required")
    root = Path(git("rev-parse", "--show-toplevel").rstrip("\n")).resolve()
    primary = next(worktrees(root))
    if args.command == "start":
        branch = branch_name(args.name)
        path = primary.with_name(f"{primary.name}-{args.name}")
        if path.exists() or path.is_symlink():
            raise Refusal(f"a checkout already exists at {path}")
        base = fetch_main()
        try:
            git("worktree", "add", "--no-track", "-b", branch, str(path), base, capture=False)
        except subprocess.CalledProcessError:
            if (path / ".git").is_file() and git("rev-parse", "HEAD", cwd=path).strip() == base:
                owned_branch(path, primary)
                receipt = git_dir(path) / "todoist-session-base"
                if not receipt.exists():
                    write_base_record(receipt, base)
                raise Refusal(f"the checkout was created at {path}. Inspect Git's output and "
                              "continue from that checkout after resolving the failure.") from None
            raise
        write_base_record(git_dir(path) / "todoist-session-base", base)
        print(f"Open the chat in {path} ({branch} at {base}).")
    elif args.command == "overlaps":
        if Path.cwd().resolve() != root:
            raise Refusal("run overlaps from the worktree root")
        overlaps(root, args.paths)
    elif args.command == "land":
        os.chdir(root)
        land(root, primary)
    elif args.command == "end":
        os.chdir(root)
        end(root, primary)


if __name__ == "__main__":
    try:
        main()
    except (Refusal, OSError, subprocess.CalledProcessError) as error:
        sys.exit(f"session: {error}")
